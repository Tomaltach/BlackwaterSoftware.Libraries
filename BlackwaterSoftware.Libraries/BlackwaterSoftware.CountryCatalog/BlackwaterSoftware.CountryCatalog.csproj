<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Framework -->
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet package metadata -->
        <PackageId>BlackwaterSoftware.CountryCatalog</PackageId>
        <Version>1.0.0</Version>
        <Title>BlackwaterSoftware.CountryCatalog</Title>
        <Description>A compiled catalogue of countries and territories with ISO 3166-1 alpha-2 and alpha-3 codes, international calling codes, currency information, and geographic classifications.</Description>
        <Authors>Thomas Donegan</Authors>
        <Company>Blackwater Software</Company>
        <Product>CountryCatalog</Product>

        <!-- Package documentation -->
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>countries;country-catalog;ISO-3166;ISO2;ISO3;calling-codes;currency;geography</PackageTags>

        <!-- Package generation -->
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

        <!-- Source repository -->
        <RepositoryType>git</RepositoryType>
        <!-- Add RepositoryUrl when your remote repository is available -->
        <!-- <RepositoryUrl>https://github.com/your-org/your-repo</RepositoryUrl> -->

        <!-- Build configuration -->
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <ItemGroup>
        <None Update="README.md"
              Pack="true"
              PackagePath="\" />

        <None Update="$(OutputPath)$(AssemblyName).xml"
              Pack="true"
              PackagePath="lib/$(TargetFramework)/"
              Visible="false" />
    </ItemGroup>

</Project>
